{
	"name": "@project-template/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "pnpm --filter @project-template/ui build",
		"build": "vite build",
		"dev": "vite",
		"generate:api-types": "openapi-typescript ../docs/public/openapi.json -o src/shared/api/openapi.d.ts",
		"lint": "eslint .",
		"preview": "vite preview",
		"pretest": "pnpm --filter @project-template/ui build",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:list": "playwright test --list",
		"test:watch": "vitest",
		"pretypecheck": "pnpm --filter @project-template/ui build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@project-template/ui": "workspace:*",
		"@tanstack/react-query": "^5.101.2",
		"lucide-react": "^0.468.0",
		"openapi-fetch": "^0.15.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"jsdom": "^27.4.0",
		"openapi-typescript": "^7.13.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-axe": "^0.1.0"
	}
}
